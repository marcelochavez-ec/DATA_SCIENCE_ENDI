import os
import kaggle
import pandas as pd
from sqlalchemy import create_engine, Column, Integer, String, Float, ForeignKey, text
from sqlalchemy.orm import declarative_base, sessionmaker

# 🔹 1️⃣ Descargar los archivos de Kaggle
dataset_name = "mysarahmadbhat/pizza-place-sales"
download_path = "pizza_data"

# Descargar y descomprimir
kaggle.api.dataset_download_files(dataset_name, path=download_path, unzip=True)

# Cargar los archivos en dataframes con encoding correcto
orders_df = pd.read_csv(f"{download_path}/orders.csv", encoding="latin-1")
order_details_df = pd.read_csv(f"{download_path}/order_details.csv", encoding="latin-1")
pizzas_df = pd.read_csv(f"{download_path}/pizzas.csv", encoding="latin-1")
pizza_types_df = pd.read_csv(f"{download_path}/pizza_types.csv", encoding="latin-1")

# 🔹 2️⃣ Conectar a PostgreSQL y crear el esquema "pizza"
DATABASE_URL = "postgresql://postgres:marce@localhost/db_stat"  # Reemplaza con tus credenciales
engine = create_engine(DATABASE_URL)
Base = declarative_base()

# Crear el esquema solo una vez
with engine.connect() as conn:
    conn.execute(text("CREATE SCHEMA IF NOT EXISTS pizza;"))

# 🔹 3️⃣ Definir Tablas con Relaciones
class Orders(Base):
    __tablename__ = "orders"
    __table_args__ = {"schema": "pizza"}
    order_id = Column(String, primary_key=True)
    date = Column(String)
    time = Column(String)

class OrderDetails(Base):
    __tablename__ = "order_details"
    __table_args__ = {"schema": "pizza"}
    order_details_id = Column(Integer, primary_key=True, autoincrement=True)
    order_id = Column(String, ForeignKey("pizza.orders.order_id"))
    pizza_id = Column(String, ForeignKey("pizza.pizzas.pizza_id"))
    quantity = Column(Integer)

class Pizzas(Base):
    __tablename__ = "pizzas"
    __table_args__ = {"schema": "pizza"}
    pizza_id = Column(String, primary_key=True)
    pizza_type_id = Column(String, ForeignKey("pizza.pizza_types.pizza_type_id"))
    size = Column(String)
    price = Column(Float)

class PizzaTypes(Base):
    __tablename__ = "pizza_types"
    __table_args__ = {"schema": "pizza"}
    pizza_type_id = Column(String, primary_key=True)
    name = Column(String)
    category = Column(String)
    ingredients = Column(String)

# Crear todas las tablas
Base.metadata.create_all(engine)

# 🔹 4️⃣ Insertar Datos en PostgreSQL
Session = sessionmaker(bind=engine)
session = Session()

# Primero insertamos pizza_types
pizza_types_df.to_sql("pizza_types", engine, schema="pizza", if_exists="append", index=False)

# Luego pizzas
pizzas_df.to_sql("pizzas", engine, schema="pizza", if_exists="append", index=False)

# Después orders
existing_orders = pd.read_sql("SELECT order_id FROM pizza.orders", engine)
orders_df = orders_df[~orders_df['order_id'].isin(existing_orders['order_id'])]
orders_df.to_sql("orders", engine, schema="pizza", if_exists="append", index=False)

# Verifica si todos los pizza_id en order_details están en pizzas
missing_pizzas = order_details_df[~order_details_df['pizza_id'].isin(pizzas_df['pizza_id'])]
if not missing_pizzas.empty:
    print("Los siguientes pizza_id no están presentes en la tabla pizzas:", missing_pizzas)
else:
    # Filtra los order_id existentes en orders
    existing_order_ids = pd.read_sql("SELECT order_id FROM pizza.orders", engine)
    order_details_df = order_details_df[order_details_df['order_id'].isin(existing_order_ids['order_id'])]
    
    # Finalmente order_details
    order_details_df.to_sql("order_details", engine, schema="pizza", if_exists="append", index=False)

session.commit()
session.close()

print("✅ Pipeline completado: Datos almacenados en PostgreSQL.")


