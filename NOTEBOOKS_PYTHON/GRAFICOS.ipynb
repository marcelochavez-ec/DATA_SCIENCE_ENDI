    "import matplotlib.pyplot as plt\n",
    "\n",
    "fig, ax = plt.subplots()\n",
    "\n",
    "# Graficar una línea\n",
    "ax.plot([1, 2, 3, 4], [10, 20, 25, 30], label=\"Línea\", color=\"blue\")\n",
    "\n",
    "# Agregar puntos dispersos\n",
    "ax.scatter([1, 2, 3, 4], [10, 20, 25, 30], color=\"red\", label=\"Puntos\")\n",
    "\n",
    "# Agregar título y etiquetas\n",
    "ax.set_title(\"Ejemplo de múltiples gráficos\")\n",
    "ax.set_xlabel(\"Eje X\")\n",
    "ax.set_ylabel(\"Eje Y\")\n",
    "\n",
    "# Mostrar leyenda\n",
    "ax.legend()\n",
    "\n",
    "plt.show()"
   ]
