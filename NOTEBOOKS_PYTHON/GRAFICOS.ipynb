   "source": [
    "# ----------------------------------------------------------------------------------\n",
    "# 1. CARGAR EL DATASET\n",
    "# ----------------------------------------------------------------------------------\n",
    "# Seaborn tiene varios datasets predefinidos, uno de ellos es 'mpg', que contiene:\n",
    "# - Información sobre consumo de combustible de diferentes automóviles.\n",
    "# - Variables como cilindros, caballos de fuerza, origen, etc.\n",
    "\n",
    "# ----------------------------------------------------------------------------------\n",
    "# 2. CREAR LA FIGURA Y LOS EJES\n",
    "# ----------------------------------------------------------------------------------\n",
    "# Creamos un lienzo (fig) y un eje (ax) con un tamaño de 8x5 pulgadas.\n",
    "fig, ax = plt.subplots(figsize=(8, 5))\n",
    "\n",
    "# ----------------------------------------------------------------------------------\n",
    "# 3. AGREGAR UN BOXPLOT AL GRÁFICO\n",
    "# ----------------------------------------------------------------------------------\n",
    "# El boxplot muestra la distribución de los valores de 'horsepower' (caballos de fuerza)\n",
    "# agrupados por 'cylinders' (número de cilindros del motor).\n",
    "sns.boxplot(\n",
    "    x=\"cylinders\", \n",
    "    y=\"horsepower\", \n",
    "    data=mpg, \n",
    "    ax=ax, \n",
    "    width=0.5,                # Ancho de las cajas\n",
    "    boxprops={'alpha': 0.5}   # Transparencia de las cajas (para ver los puntos mejor)\n",
    ")\n",
    "\n",
    "# ----------------------------------------------------------------------------------\n",
    "# 4. AGREGAR UN DIAGRAMA DE DISPERSIÓN (SCATTER PLOT)\n",
    "# ----------------------------------------------------------------------------------\n",
    "# El scatter plot superpuesto nos permite ver los valores individuales de los datos.\n",
    "sns.stripplot(\n",
    "    x=\"cylinders\", \n",
    "    y=\"horsepower\", \n",
    "    data=mpg, \n",
    "    ax=ax, \n",
    "    color=\"black\",  # Puntos en negro\n",
    "    alpha=0.6       # Transparencia para evitar saturación\n",
    ")\n",
    "\n",
    "# ----------------------------------------------------------------------------------\n",
    "# 5. MOSTRAR EL GRÁFICO\n",
    "# ----------------------------------------------------------------------------------\n",
    "plt.show()"
   ]
  },
